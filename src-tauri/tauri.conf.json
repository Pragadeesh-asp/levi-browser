{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LEVI BROWSER — Isolation Lab",
  "version": "0.1.0",
  "identifier": "com.levi.browser.foundation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LEVI BROWSER — Isolation Lab",
        "width": 1120,
        "height": 760,
        "minWidth": 840,
        "minHeight": 620,
        "dataDirectory": "browser-shell"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
